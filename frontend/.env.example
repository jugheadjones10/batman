# Optional: set to your backend origin (e.g. http://127.0.0.1:8000) so the
# inference result video loads directly from the API and avoids proxy streaming issues.
# VITE_API_ORIGIN=http://127.0.0.1:8000

# Optional: if you get ECONNREFUSED on /api, frontend and backend may be in different
# environments (e.g. frontend on Windows, backend in WSL). Set the proxy target:
# VITE_API_PROXY_TARGET=http://localhost:8000
